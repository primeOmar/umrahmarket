{
  "functions": {
    "api/ssr.js": {
      "includeFiles": "{dist/server/**,node_modules/react-router/**,node_modules/react-router-dom/**}"
    }
  },
  "rewrites": [
    {
      "source": "/backend-proxy/:path*",
      "destination": "https://api.umrahmarket.net/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/client/assets/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "/client/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/umrahmarket.jpg",
      "destination": "/client/umrahmarket.jpg"
    },
    {
      "source": "/umrahmarket.png",
      "destination": "/client/umrahmarket.png"
    },
    {
      "source": "/umramarket.png",
      "destination": "/client/umramarket.png"
    },
    {
      "source": "/umramarket1.png",
      "destination": "/client/umramarket1.png"
    },
    {
      "source": "/vite.svg",
      "destination": "/client/vite.svg"
    },
    {
      "source": "/favicon.ico",
      "destination": "/client/favicon.ico"
    },
    {
      "source": "/favicon-16x16.png",
      "destination": "/client/favicon-16x16.png"
    },
    {
      "source": "/favicon-32x32.png",
      "destination": "/client/favicon-32x32.png"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/client/apple-touch-icon.png"
    },
    {
      "source": "/android-chrome-192x192.png",
      "destination": "/client/android-chrome-192x192.png"
    },
    {
      "source": "/android-chrome-512x512.png",
      "destination": "/client/android-chrome-512x512.png"
    },
    {
      "source": "/",
      "destination": "/api/ssr"
    },
    {
      "source": "/:path((?!.*\\.).*)",
      "destination": "/api/ssr"
    }
  ]
}
